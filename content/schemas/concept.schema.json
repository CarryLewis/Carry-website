{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carrylewis.com/schemas/concept.json",
  "title": "Concept",
  "description": "Connected knowledge nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "category",
    "summary",
    "references",
    "connectedNodeIds"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/entityId" },
    "slug": { "$ref": "common.schema.json#/$defs/entityId" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "$ref": "common.schema.json#/$defs/conceptCategory" },
    "summary": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/reference" }
    },
    "connectedNodeIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/entityId" }
    },
    "layout": { "$ref": "common.schema.json#/$defs/layoutHint" }
  }
}
