{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carrylewis.com/schemas/relations-collection.json",
  "title": "RelationsCollection",
  "description": "Global relation edge store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "edges"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "edges": {
      "type": "array",
      "items": { "$ref": "relation.schema.json" }
    }
  }
}
